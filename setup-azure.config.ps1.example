# -----------------------------------------------------------------------------
# Sao chép file này thành setup-azure.config.ps1 rồi điền giá trị thật.
#   Copy-Item setup-azure.config.ps1.example setup-azure.config.ps1
#
# File setup-azure.config.ps1 nên nằm ngoài Git (đã liệt kê trong .gitignore).
# Chạy từ thư mục gốc repo:
#   .\setup-azure.config.ps1
# -----------------------------------------------------------------------------

$ErrorActionPreference = "Stop"
$RepoRoot = Split-Path -Parent $MyInvocation.MyCommand.Path

# --- Điền thông tin Azure của bạn (Portal > Azure Active Directory / Subscriptions) ---
$SubscriptionId = "00000000-0000-0000-0000-000000000000"
$TenantId = "00000000-0000-0000-0000-000000000000"

# Hậu tố duy nhất (chỉ a-z, 0-9, 4-8 ký tự). Ví dụ: mã lớp + tên viết tắt: "isec25a1"
$ResourceSuffix = "yourid01"

# Tuỳ chọn: bỏ qua az login nếu session đã đăng nhập đúng tenant
# $SkipLogin = $true

$params = @{
    SubscriptionId = $SubscriptionId
    TenantId       = $TenantId
    ResourceSuffix = $ResourceSuffix.ToLowerInvariant()
}

if ($SkipLogin) {
    $params["SkipAzLogin"] = $true
}

& (Join-Path $RepoRoot "setup-azure.ps1") @params
